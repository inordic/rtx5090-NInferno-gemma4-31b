+// A verify pass runs each projection under ops::verify_linear_policy (A16). Experiment:
+// NINFERNO_GEMMA4_VERIFY_A4=1 keeps the recorded policy there (W4A4 where the checkpoint was
+// calibrated for it), as prefill does.
+static ops::LinearPolicy verify_policy(ops::LinearPolicy recorded) {
+    static const bool a4 = [] {
+        const char* e = std::getenv("NINFERNO_GEMMA4_VERIFY_A4");
+        return e != nullptr && e[0] == 1;
+    }();
+    return a4 ? recorded : ops::verify_linear_policy(recorded);
+}
