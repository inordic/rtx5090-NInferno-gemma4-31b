--- a/include/ninferno/ops/gemma4_attention.h
+++ b/include/ninferno/ops/gemma4_attention.h
@@ -48,7 +48,22 @@ namespace ninferno::ops {
  * first stored[b] tokens only, and its later tokens write nothing. A verify call pads a row with
  * fewer drafts than the launch's width by repeating the position of its last token; without it
  * those columns would race that token for its slot. Readers ignore it.
+ *
+ * Shared values (v_from_k != 0): a k_eq_v full layer (D = 512, 64 rotated pairs, a key norm whose
+ * weight is one constant c) has V = unrope(K) / c, so V equals K / c on every dimension RoPE does
+ * not rotate. Such a layer keeps FP8 K planes as above and a V plane of only the
+ * kGemma4SharedValueDims rotated dimensions ([0, 64) then [256, 320)), coded against the K row's
+ * scale and with no scale plane of its own (v_scale empty); v_from_k is 1 / c. The K row scale is
+ * taken over the rotated pairs' norms, so the unrotated values fit the same scale. Readers take
+ * V's other dimensions from the K codes and scale the output by v_from_k.
+ *
+ * With a V plane of kGemma4SharedValueDimsRope (one code per row, never read or written) V keeps
+ * nothing of its own: readers turn the K codes of the rotated pairs back by their RoPE angle
+ * (rope_theta; 64 of the 256 pairs (i, i + 256) of D = 512 rotate) instead.
  */
+inline constexpr std::int32_t kGemma4SharedValueDims     = 128;
+inline constexpr std::int32_t kGemma4SharedValueDimsRope = 1;
+
 struct Gemma4KvLayer {
     Tensor k;
     Tensor v;
@@ -58,6 +73,8 @@ struct Gemma4KvLayer {
     Tensor k_scale;
     Tensor v_scale;
     Tensor stored;
+    float v_from_k   = 0.0f;
+    float rope_theta = 0.0f; // shared values without a V plane: the full layers' RoPE base
 };
 
