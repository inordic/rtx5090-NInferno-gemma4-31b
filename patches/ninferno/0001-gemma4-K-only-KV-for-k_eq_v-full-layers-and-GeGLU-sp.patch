+// BF16 pool keeps both planes whole). The V plane's width per row, 0 when not asked.
+std::int32_t shared_value_dims(const Config& c) {
+    const char* flag = std::getenv("NINFERNO_GEMMA4_SHARED_VALUES");
+    if (flag == nullptr || !c.k_eq_v || c.full.head_dim != 512 ||
+        c.full.rotary_pairs * 2 != ops::kGemma4SharedValueDims) {
