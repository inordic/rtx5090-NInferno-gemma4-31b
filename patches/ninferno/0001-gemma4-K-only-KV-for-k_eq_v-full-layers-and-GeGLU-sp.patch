+                const Tensor& w = model.weights().layers[static_cast<std::size_t>(i)].key_norm;
+                std::vector<std::uint16_t> host(static_cast<std::size_t>(w.numel()));
+                CUDA_CHECK(cudaMemcpy(host.data(), w.data, host.size() * sizeof(std::uint16_t),
+                                      cudaMemcpyDeviceToHost));
+                if (host.empty() ||
+                    std::any_of(host.begin(), host.end(), [&](auto x) { return x != host[0]; })) {
+                    throw std::invalid_argument(
+                        "NINFERNO_GEMMA4_SHARED_VALUES: a full layer's key norm weight is not one "
+                        "constant, so V is not unrope(K) / c");
