+// Shared values without a V plane: the rotated pairs' frequencies theta^(-2i/512) and their
+// 1024-position steps mod 2 pi, formed in FP64 so the kernel's FP32 angle stays exact enough.
+void set_rope_tables(Gemma4AttentionArgs& args, float theta) {
+    constexpr double kTwoPi = 6.28318530717958648;
+    const double log_theta  = std::log(static_cast<double>(theta));
+    for (int i = 0; i < kGemma4SharedValueDims / 2; ++i) {
+        const double f         = std::exp(-(2.0 * i / 512.0) * log_theta);
+        args.rope_frequency[i] = static_cast<float>(f);
+        args.rope_block[i]     = static_cast<float>(std::fmod(1024.0 * f, kTwoPi));
+    }
+}
