+// Finished generation requests since start, summed (HttpServer::record_request_done and
+// record_request_failure). A scraper takes the difference of two samples: when one request finished
+// in between, its phases and tokens are exact.
+struct RequestTotals {
+    std::uint64_t finished              = 0; // requests that completed; the sums below cover them
+    double e2e_seconds                  = 0.0;
+    double queue_seconds                = 0.0;
+    double ttft_seconds                 = 0.0;
+    double prefill_seconds              = 0.0;
+    double decode_seconds               = 0.0;
+    std::uint64_t prompt_tokens         = 0;
+    std::uint64_t cached_prompt_tokens  = 0; // served from the context cache instead of prefill
+    std::uint64_t generation_tokens     = 0;
+    std::uint64_t speculative_rounds    = 0;
+    std::uint64_t speculative_drafted   = 0;
+    std::uint64_t speculative_accepted  = 0;
+    // stop, length, tool_calls, abort, repetition (completed) and error (failed)
+    std::map<std::string, std::uint64_t, std::less<>> finish_reasons;
+};
+
 // GET /metrics: Prometheus text exposition under llama.cpp's metric names (dashboards made for it
-// read ours), plus ninferno's own counters and the decision fingerprint's info gauge
-// (ninferno_decision_fingerprint_info{fingerprint,manifest,schema} 1, when metadata carries one).
+// read ours), plus ninferno's own counters, the finished-request sums (ninferno_request_*,
+// ninferno_speculative_*, ninferno_requests_finished_total{finish_reason}) and the decision
+// fingerprint's info gauge (ninferno_decision_fingerprint_info{fingerprint,manifest,schema} 1, when
+// metadata carries one).
 std::string make_prometheus_metrics(const ninferno::RuntimeStats& stats,
                                     std::uint32_t http_active_requests,
-                                    const ninferno::ModelMetadata& metadata);
+                                    const ninferno::ModelMetadata& metadata,
+                                    const RequestTotals& requests = RequestTotals{});
 std::string make_error_body(const ApiError& error);
 std::int64_t unix_time_now();
 
