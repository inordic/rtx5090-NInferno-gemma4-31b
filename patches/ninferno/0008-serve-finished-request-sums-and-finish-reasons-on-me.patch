@@ -425,16 +425,63 @@ void HttpServer::record_request_rejected(const RequestRejectionLogContext& conte
     operational_log_.request_rejected(context);
 }
 
+namespace {
+
+// The OpenAI spelling of how a completed request ended, as /metrics labels it.
+std::string_view finished_label(const GenerationOutcome& outcome) {
+    if (!outcome.tool_calls.empty()) { return "tool_calls"; }
+    switch (outcome.finish_reason) {
+    case ninferno::FinishReason::StopToken:
+    case ninferno::FinishReason::StopString:
+        return "stop";
+    case ninferno::FinishReason::OutputLimit:
+    case ninferno::FinishReason::ContextCapacity:
+        return "length";
+    case ninferno::FinishReason::Cancelled:
+        return "abort";
+    case ninferno::FinishReason::Repetition:
+        return "repetition";
+    case ninferno::FinishReason::None:
+        break;
+    }
+    return "other";
+}
+
+} // namespace
+
 void HttpServer::record_request_done(const RequestLogContext& context,
                                      const GenerationOutcome& outcome) {
     request_jsonl_.write_request_done(context, outcome);
     operational_log_.request_done(context, outcome);
+    const GenerationMetrics& m = outcome.metrics;
+    const std::lock_guard<std::mutex> lock(request_totals_mutex_);
+    RequestTotals& t = request_totals_;
+    ++t.finished;
+    t.e2e_seconds += m.total_seconds;
+    t.queue_seconds += m.engine_timing.queue_wait_seconds;
+    t.ttft_seconds += m.ttft_seconds;
+    t.prefill_seconds += m.prefill_seconds;
+    t.decode_seconds += m.decode_seconds;
+    t.prompt_tokens += static_cast<std::uint64_t>(std::max(outcome.prompt_tokens, 0));
+    t.cached_prompt_tokens += m.prefix_cache_hit_tokens;
+    t.generation_tokens += static_cast<std::uint64_t>(std::max(outcome.completion_tokens, 0));
+    t.speculative_rounds += m.speculative_rounds;
+    t.speculative_drafted += m.speculative_draft_tokens;
+    t.speculative_accepted += m.speculative_accepted_tokens;
+    const std::string_view label = finished_label(outcome);
+    if (auto it = t.finish_reasons.find(label); it != t.finish_reasons.end()) {
+        ++it->second;
+    } else {
+        t.finish_reasons.emplace(std::string(label), 1);
+    }
 }
 
 void HttpServer::record_request_failure(const RequestLogContext& context,
                                         const RequestFailure& failure) {
     request_jsonl_.write_request_error(context, failure.machine_message);
     operational_log_.request_failure(context, failure);
+    const std::lock_guard<std::mutex> lock(request_totals_mutex_);
+    ++request_totals_.finish_reasons["error"];
 }
 
 void HttpServer::record_response_failure(std::uint64_t request_id, const RequestFailure& failure) {
@@ -616,8 +663,14 @@ void HttpServer::register_routes() {
     server_.Get("/metrics", [this](const httplib::Request&, httplib::Response& res) {
         const ninferno::RuntimeStats stats =
             service_ != nullptr ? service_->runtime_stats() : ninferno::RuntimeStats{};
-        res.set_content(make_prometheus_metrics(stats, active_requests_.load(), model_metadata_),
-                        "text/plain; version=0.0.4");
+        RequestTotals requests;
+        {
+            const std::lock_guard<std::mutex> lock(request_totals_mutex_);
+            requests = request_totals_;
+        }
+        res.set_content(
+            make_prometheus_metrics(stats, active_requests_.load(), model_metadata_, requests),
+            "text/plain; version=0.0.4");
     });
     server_.Get(
         api_route_pattern("/models"),
