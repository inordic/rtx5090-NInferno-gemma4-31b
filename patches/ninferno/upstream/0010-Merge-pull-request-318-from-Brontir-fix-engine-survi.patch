 src/models/gemma4/program_family.cpp          | 60 ++++++++++++---
 src/models/gemma4/vision.cpp                  |  6 +-
 .../qwen3_5/frontend/output_session.cpp       | 57 ++++++++++++++
 src/runtime/engine/engine_core.h              | 76 +++++++++++++++++--
 tests/models/qwen3_5/test_frontend.cpp        | 39 ++++++++++
 6 files changed, 227 insertions(+), 19 deletions(-)

