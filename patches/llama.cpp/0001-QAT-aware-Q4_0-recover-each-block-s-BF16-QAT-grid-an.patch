diff --git a/ggml/src/ggml-quants.c b/ggml/src/ggml-quants.c
index 7750a72..13aeddb 100644
--- a/ggml/src/ggml-quants.c
+++ b/ggml/src/ggml-quants.c
@@ -2126,7 +2126,72 @@ size_t quantize_q2_0(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst,
     return nrow * row_size;
 }
 
+// QAT-aware Q4_0 (GGML_Q4_0_QAT=1): weights of a QAT checkpoint sit on a q4 grid w = q * s, q in
+// [-8, 7], with one BF16 scale s per 32-weight block. The reference encoder takes d = max / -8 in
+// FP16, which moves most blocks off that grid; here s is recovered as bf16(amax / k) for the k in
+// 1..8 that puts every weight on an integer in [-8, 7], and stored exactly. Blocks that sit on no
+// grid (an abliterated row, an unquantized tensor) take the reference encoder.
+static float q4_0_qat_bf16_round(float v) {
+    uint32_t u; memcpy(&u, &v, 4);
+    u += 0x7fffu + ((u >> 16) & 1u);
+    u &= 0xffff0000u;
+    memcpy(&v, &u, 4);
+    return v;
+}
+
+static int64_t q4_0_qat_blocks_on_grid = 0, q4_0_qat_blocks_total = 0;
+
+static void quantize_row_q4_0_qat(const float * GGML_RESTRICT x, block_q4_0 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK4_0;
+    const int nb = k / qk;
+    int64_t on = 0;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        float amax = 0.0f;
+        for (int j = 0; j < qk; j++) { amax = MAX(amax, fabsf(xb[j])); }
+        float best_s = 0.0f, best_err = INFINITY;
+        if (amax > 0.0f) {
+            for (int kk = 1; kk <= 8; ++kk) {
+                const float s = q4_0_qat_bf16_round(amax / kk);
+                if (!(s > 0.0f) || GGML_FP16_TO_FP32(GGML_FP32_TO_FP16(s)) != s) { continue; }
+                float err = 0.0f;
+                bool ok = true;
+                for (int j = 0; j < qk; j++) {
+                    const float t = xb[j] / s;
+                    const float r = nearbyintf(t);
+                    if (r < -8.0f || r > 7.0f) { ok = false; break; }
+                    err = MAX(err, fabsf(t - r));
+                }
+                if (ok && err < best_err) { best_err = err; best_s = s; }
+            }
+        }
+        if (best_s == 0.0f || best_err > 0.05f) {
+            quantize_row_q4_0_ref(xb, y + i, qk);
+            continue;
+        }
+        ++on;
+        y[i].d = GGML_FP32_TO_FP16(best_s);
+        for (int j = 0; j < qk/2; ++j) {
+            const int q0 = (int)nearbyintf(xb[j]        / best_s) + 8;
+            const int q1 = (int)nearbyintf(xb[j + qk/2] / best_s) + 8;
+            y[i].qs[j] = (uint8_t)q0 | (uint8_t)(q1 << 4);
+        }
+    }
+    q4_0_qat_blocks_on_grid += on;
+    q4_0_qat_blocks_total   += nb;
+    if (getenv("GGML_Q4_0_QAT_VERBOSE")) {
+        fprintf(stderr, "[q4_0 qat] %lld/%lld blocks on grid (running %.2f%%)\n", (long long) on,
+                (long long) nb, 100.0 * q4_0_qat_blocks_on_grid / q4_0_qat_blocks_total);
+    }
+}
+
 size_t quantize_q4_0(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    static int qat = -1;
+    if (qat < 0) { const char * e = getenv("GGML_Q4_0_QAT"); qat = e && atoi(e) ? 1 : 0; }
+    if (qat) {
+        quantize_row_q4_0_qat(src, dst, (int64_t)nrow*n_per_row);
+        return nrow * ggml_row_size(GGML_TYPE_Q4_0, n_per_row);
+    }
     if (!quant_weights) {
         quantize_row_q4_0_ref(src, dst, (int64_t)nrow*n_per_row);
         return nrow * ggml_row_size(GGML_TYPE_Q4_0, n_per_row);
diff --git a/gguf-py/gguf/quants.py b/gguf-py/gguf/quants.py
index cc07729..d9dcdb3 100644
--- a/gguf-py/gguf/quants.py
+++ b/gguf-py/gguf/quants.py
@@ -218,9 +218,55 @@ class BF16(__Quant, qtype=GGMLQuantizationType.BF16):
         return (blocks.view(np.int16).astype(np.int32) << 16).view(np.float32)
 
 
+def _q4_0_qat_grid(blocks: np.ndarray):
+    # QAT checkpoints store w = q * s, q in [-8, 7], one BF16 scale s per 32-weight block: recover
+    # s = bf16(amax / k) for the k in 1..8 that puts every weight on an integer in [-8, 7].
+    amax = np.abs(blocks).max(axis=-1, keepdims=True)
+    best_s = np.zeros_like(amax)
+    best_err = np.full(amax.shape, np.inf, dtype=np.float32)
+    for k in range(1, 9):
+        s = (amax / k).astype(np.float32)
+        u = s.view(np.uint32)
+        u = ((u + np.uint32(0x7FFF) + ((u >> np.uint32(16)) & np.uint32(1))) & np.uint32(0xFFFF0000))
+        s = u.view(np.float32)
+        s16 = s.astype(np.float16).astype(np.float32)
+        valid = (s > 0) & (s16 == s)
+        with np.errstate(divide="ignore", invalid="ignore"):
+            t = np.where(valid, blocks / np.where(valid, s, 1), 0)
+        r = np.rint(t)
+        ok = valid & ((r >= -8) & (r <= 7)).all(axis=-1, keepdims=True)
+        err = np.where(ok, np.abs(t - r).max(axis=-1, keepdims=True), np.inf)
+        better = err < best_err
+        best_err = np.where(better, err, best_err)
+        best_s = np.where(better, s, best_s)
+    on = (best_err <= 0.05) & (best_s > 0)
+    return on, best_s
+
+
 class Q4_0(__Quant, qtype=GGMLQuantizationType.Q4_0):
+    qat_on_grid = 0
+    qat_total = 0
+
     @classmethod
     def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        import os
+        if os.environ.get("GGUF_Q4_0_QAT") == "1":
+            n_blocks = blocks.shape[0]
+            on, s = _q4_0_qat_grid(blocks)
+            ref = cls._quantize_blocks_ref(blocks)
+            with np.errstate(divide="ignore", invalid="ignore"):
+                q = np.rint(np.where(on, blocks / np.where(on, s, 1), 0)).astype(np.int8) + np.int8(8)
+            q = q.astype(np.uint8).reshape((n_blocks, 2, cls.block_size // 2))
+            q = q[..., 0, :] | (q[..., 1, :] << np.uint8(4))
+            d = s.astype(np.float16).view(np.uint8)
+            qat = np.concatenate([d, q], axis=-1)
+            cls.qat_on_grid += int(on.sum())
+            cls.qat_total += n_blocks
+            return np.where(on, qat, ref)
+        return cls._quantize_blocks_ref(blocks)
+
+    @classmethod
+    def _quantize_blocks_ref(cls, blocks: np.ndarray) -> np.ndarray:
         n_blocks = blocks.shape[0]
 
         imax = abs(blocks).argmax(axis=-1, keepdims=True)
-- 
